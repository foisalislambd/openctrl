# Optional. The OpenCtrl window saves settings in data/openctrl.db.
# If this file already has keys, the first launch copies them once.

# Token from BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated Telegram user ids. /start shows yours.
TELEGRAM_ALLOWED_USER_IDS=

# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Exacto routing is more accurate for tool calls. Leave empty for OpenRouter's default route.
OPENROUTER_MODEL=openai/gpt-6-luna-pro
OPENROUTER_PROVIDER_SORT=exacto

MAX_STEPS=30
MAX_OUTPUT_TOKENS=12000

# Stop and ask before one task spends more than this many dollars. 0 disables the limit.
MAX_TASK_COST=0.50

# Voice notes are transcribed with this model, then run as a task.
OPENROUTER_TRANSCRIBE_MODEL=openai/whisper-large-v3

# Create a Startup shortcut so OpenCtrl opens when you log on. It is not a Windows service.
START_WITH_WINDOWS=1
